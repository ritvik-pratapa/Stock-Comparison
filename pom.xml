<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project coordinates: together these uniquely identify the project. -->
    <groupId>com.stockscope</groupId>
    <artifactId>stockscope</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>StockScope</name>
    <description>Compare public companies using real financial data from the SEC EDGAR API.</description>

    <properties>
        <!-- Compile for Java 17 so the app runs on any JDK 17 or newer. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions in one place, so upgrading is a one-line change. -->
        <jackson.version>2.22.4</jackson.version>
        <jfreechart.version>1.5.6</jfreechart.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- Jackson: turns the SEC's JSON responses into Java objects. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JFreeChart: draws bar and line charts and saves them as PNG files. -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>${jfreechart.version}</version>
        </dependency>

        <!-- JUnit: unit testing. "test" scope means it is only used by tests,
             not shipped with the application. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <!-- Surefire runs the JUnit tests during "mvn test". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>

            <!-- Lets us start the app with "mvn exec:java". -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>com.stockscope.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
